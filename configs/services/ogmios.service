[Unit]
Description       = Ogmios Service (OGMIOS_SERVICE)
Wants             = network-online.target
After             = network-online.target

[Service]
User              = NODE_USER
Type              = simple
WorkingDirectory  = NODE_HOME
ExecStart         = /bin/bash -c 'NODE_HOME/scripts/ogmios.sh run'
KillSignal        = SIGINT
RestartKillSignal = SIGINT
TimeoutStopSec    = 300
LimitNOFILE       = 32768
Restart           = always
RestartSec        = 5
SyslogIdentifier  = OGMIOS_SERVICE

[Install]
WantedBy          = multi-user.target
